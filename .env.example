# Supabase — required for live data + magic-link auth.
# Without these the app runs on the bundled seed dataset (src/lib/data/seed.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox — required for the property location map.
# Without it the map section renders a static brand-styled fallback.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Public site URL, used for magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
